# Supabase project shared with TypeKana (public values — the anon/publishable key is safe in the browser;
# Row Level Security decides what it can do). Copy to .env.local for local runs; set the same two in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or sb_publishable_ key>
