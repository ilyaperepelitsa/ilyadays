# Use a dedicated ilyadays Supabase project. See docs/supabase-cutover.md for database, OAuth and Vercel setup.
# These values are public; Row Level Security controls access. Never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_ key>
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY remains supported; remove it from Vercel when using the new key above.
