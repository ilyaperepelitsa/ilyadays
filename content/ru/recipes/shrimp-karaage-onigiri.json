    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"1.6667\">1⅔ стакана</span><span class=\"qalt\"> (<span class=\"q\" data-k=\"vol\" data-u=\"ml\" data-a=\"400\" data-alt=\"1\">400 мл</span>)</span>",
     "name_html": "Вода (для риса)"
    }
   ]
