      "caption": "Шершавой стороной вверх, тэнмусу посередине; загните оба конца через перед, как воротник кимоно.",
      "src": "illustrations/tenmusu/11-how2.webp?v=a9ec049bfb"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/tenmusu/11.webp?v=7a43ef88a9",
    "svg_fallback": null
   },
