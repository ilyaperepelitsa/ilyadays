 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Поставьте циркулятор на <b>85 °C</b>.</li><li>Подготовьте всё, пока греется.</li></ul>",
   "heat": null,
   "id": "step-1",
   "images": {
    "alt": "Разогреть баню",
    "how": [],
    "illustration": "illustrations/sous-vide-beets/1.webp",
