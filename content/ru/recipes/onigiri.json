   "time_html": "<span>~2 мин на штуку</span>",
   "title": "Бакудан — «бомба»",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"3\" data-f=\"лист|листа|листов\" data-n=\"1\">3 листа</span>",
     "name_html": "Нори"
    }
