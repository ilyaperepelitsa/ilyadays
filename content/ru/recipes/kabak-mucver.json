     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"60\">60 г</span>",
     "name_html": "Белый рассольный сыр, раскрошенный"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"10\">10 г</span>",
     "name_html": "Укроп, рубленый"
