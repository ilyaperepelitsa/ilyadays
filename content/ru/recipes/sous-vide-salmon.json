   "uses_rows": [
    {
     "amount_html": "2 × <span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"150\" data-b=\"180\" data-s=\"0\">150–180 г</span>",
     "name_html": "Порции лосося без мелких костей"
