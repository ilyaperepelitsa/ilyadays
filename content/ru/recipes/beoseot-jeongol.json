    },
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"100\">100 г</span>",
     "name_html": "Коричневые шампиньоны или обычные шампиньоны"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"100\">100 г</span>",
     "name_html": "Эноки"
