      "caption": "Замочите или сварите лапшу по инструкции для жарки в воке — остановитесь, пока она ещё чуть упругая.",
      "src": "illustrations/chicken-pad-see-ew/1-how1.webp?v=2d880c91e3"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/chicken-pad-see-ew/1.webp?v=3e15829732",
    "svg_fallback": null
   },
   "n": 1,
   "part": null,
