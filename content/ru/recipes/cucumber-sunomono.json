    "result": "illustrations/cucumber-sunomono/3.webp?v=e5ebd9e92d",
    "svg_fallback": null
   },
   "n": 3,
   "part": null,
   "part_id": null,
   "time": "~2 мин",
   "time_html": "<span>~2 мин</span>",
   "title": "Промыть и отжать",
   "uses_rows": []
  },
  {
   "body_html": "<p>Добавьте натёртые имбирь и чеснок и <span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1\" data-s=\"0\">1 ст. л.</span> рисового уксуса. Перемешайте.</p>",
   "heat": null,
   "id": "step-4",
   "images": {
