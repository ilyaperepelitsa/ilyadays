   "images": {
    "alt": "Острый майонез",
    "diagram": null,
    "how": [
     {
      "caption": "Смешайте майонез, шрирачу и сок лайма.",
      "src": "illustrations/tuna-mango-roll/1-how1.webp"
     }
    ],
    "illustration": null,
