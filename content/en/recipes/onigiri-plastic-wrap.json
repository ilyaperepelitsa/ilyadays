   },
   "n": 1,
   "part": "Rice",
   "part_id": "part-rice",
   "time": "~1 h incl. soaking",
   "time_html": "<span>~1 h incl. soaking</span>",
   "title": "Cook the rice",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"150\">150 g</span>",
