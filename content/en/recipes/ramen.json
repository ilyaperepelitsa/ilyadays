   },
   "n": 17,
   "part": "Noodles & assembly",
   "part_id": "part-noodles--assembly",
   "time": "1 min",
   "time_html": "<span>1 min</span>",
   "title": "Tare, then broth",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"2\" data-b=\"3\" data-s=\"0\">2–3 tbsp</span>",
     "name_html": "Tare"
