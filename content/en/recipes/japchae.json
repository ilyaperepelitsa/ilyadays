 "notes": [
  {
   "html": "<ul class=\"do\"><li>Use Korean dangmyeon (grey, made from sweet potato starch).</li><li>Mung bean vermicelli is much softer and will not have the same chew; if that's all you have, soak instead of boiling and toss gently.</li></ul>",
   "title_html": "Noodles"
  },
  {
   "html": "<ul class=\"do\"><li>Japchae holds for 2 days in the fridge.</li><li>The noodles firm up when cold: warm them in the pan with a splash of water.</li></ul>",
   "title_html": "Keeps well"
  }
 ],
