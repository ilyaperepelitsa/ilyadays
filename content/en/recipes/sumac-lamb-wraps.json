    "zoomable": true
   },
   "n": 2,
   "part": null,
   "part_id": null,
   "time": "5 min",
   "time_html": "<span>5 min</span>",
   "title": "Slice lamb across the grain",
   "uses_rows": []
  },
  {
   "body_html": "<ul class=\"do\"><li>Heat oil over medium-high heat.</li><li>Fry half the meat for 2–3 minutes, turning to brown, then repeat.</li><li>Add optional chilli in the last 20 seconds.</li><li>Check lamb reaches <b><span class=\"q\" data-k=\"temp\" data-u=\"C\" data-a=\"63\" data-s=\"0\">63 °C</span></b>, then rest for <b>3 minutes</b> on a clean plate.</li><li>Do not use the raw-meat plate.</li></ul>",
   "heat": {
    "label": "medium-high",
    "label_html": "<span>medium-high</span>",
    "off": false
   },
   "id": "step-3",
   "images": {
