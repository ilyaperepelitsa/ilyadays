     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"ml\" data-a=\"240\">240 ml</span><span class=\"qalt\"> (<span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"1\" data-alt=\"1\">1 cup</span>)</span>",
     "name_html": "Water (tezu)"
    },
