 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Salt and pepper the beef.</li><li>Sear it over heat high enough that brown bits glue themselves to the bottom of the pot — that <b>fond</b> is where the flavour comes from.</li></ul>",
   "heat": {
    "label": "medium-high",
    "off": false
   },
   "id": "step-1",
   "images": {
    "alt": "Brown the beef",
    "how": [
     {
      "caption": "Brown hard enough that browned bits stick to the bottom — that's the fond.",
      "src": "illustrations/baka-with-eggs/1-how1.webp"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/baka-with-eggs/1.webp",
    "svg_fallback": null
   },
   "n": 1,
   "part": null,
   "part_id": null,
   "time": "~15 min",
   "title": "Brown the beef",
   "uses_rows": [
