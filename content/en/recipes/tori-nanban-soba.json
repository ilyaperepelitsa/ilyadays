     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"ml\" data-a=\"400\">400 ml</span><span class=\"qalt\"> (<span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"1.6667\" data-alt=\"1\">1⅔ cups</span>)</span>",
     "name_html": "Dashi"
    }
   ]
  },
  {
   "body_html": "<p>Stir, add the tofu pouch strips and let it simmer for a few minutes.</p>",
   "heat": {
    "label": "low",
    "label_html": "<span>low</span>",
    "off": false
   },
   "id": "step-5",
   "images": {
    "alt": "Tofu pouch in",
    "diagram": null,
