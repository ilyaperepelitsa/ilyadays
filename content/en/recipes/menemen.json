 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Remove pepper seeds; cut flesh into <b><span class=\"q\" data-k=\"len\" data-u=\"mm\" data-a=\"5\" data-b=\"8\" data-s=\"0\">5–8 mm</span></b> pieces.</li><li>Heat oil over medium heat in a <span class=\"q\" data-k=\"len\" data-u=\"cm\" data-a=\"24\" data-s=\"0\">24 cm</span> pan and cook pepper for 4–5 minutes until softened, not blackened.</li></ul>",
   "heat": {
    "label": "medium",
    "label_html": "<span>medium</span>",
    "off": false
   },
