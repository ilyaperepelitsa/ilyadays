    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Add tomatoes, salt and optional chilli.</li><li>Simmer uncovered for 8–10 minutes, stirring, until thick.</li><li>Draw a spatula through: the trail should stay visible briefly rather than immediately filling with watery juice.</li><li>Canned tomatoes may need longer.</li></ul>",
   "heat": {
    "label": "medium-low",
    "label_html": "<span>medium-low</span>",
    "off": false
   },
