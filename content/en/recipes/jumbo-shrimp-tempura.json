     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"25\">25 g</span> (<span class=\"q\" data-k=\"count\" data-a=\"0.5\" data-f=\"egg|eggs\" data-n=\"1\">½ large egg</span>)",
