 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Set the circulator to <b>85 °C</b>.</li><li>Prep while it heats.</li></ul>",
   "heat": null,
   "id": "step-1",
   "images": {
    "alt": "Preheat the bath",
    "how": [],
    "illustration": "illustrations/sous-vide-beets/1.webp",
