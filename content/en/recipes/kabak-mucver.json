 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Coarsely grate courgettes.</li><li>Toss with salt and leave 5 minutes.</li><li>Wrap in a clean tea towel and squeeze hard over the sink until no steady stream runs out.</li><li>You should have roughly <span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"200\" data-b=\"250\" data-s=\"0\">200–250 g</span> squeezed courgette.</li></ul>",
   "heat": null,
   "id": "step-1",
   "images": {
    "alt": "Grate, salt and squeeze",
    "diagram": null,
    "diagram_title": "Diagram",
    "how": [],
