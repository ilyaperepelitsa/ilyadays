     },
     {
      "caption": "Then drain them in a colander.",
      "src": "illustrations/kkakdugi/1-how4.webp?v=b84ad94a91"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/kkakdugi/1.webp?v=eb40d3e679",
    "svg_fallback": null
   },
