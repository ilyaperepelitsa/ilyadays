     },
     {
      "caption": "Soak the cubes in the brine for about 5 hours.",
      "src": "illustrations/kkakdugi/1-how3.webp"
     },
     {
      "caption": "Then drain them in a colander.",
      "src": "illustrations/kkakdugi/1-how4.webp"
