     {
      "caption": "Mix the chili powder, sauces, kelp stock, juices and garlic into a thick red paste.",
      "src": "illustrations/kkakdugi/3-how3.webp"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/kkakdugi/3.webp",
    "svg_fallback": null
   },
   "n": 3,
   "part": null,
   "part_id": null,
