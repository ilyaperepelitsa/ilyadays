 "next": null,
 "notes": [
  {
   "html": "<ul class=\"do\"><li>Set every component out within reach before you start, and build several in a row.</li><li>Cracking tortillas need a little warmth; the pleat gets easier after the first one.</li><li>A tostada is the crunchiest middle but the hardest to bite; a small tortilla crisped in a pan is gentler. Crushed tortilla chips work too.</li></ul>",
   "title_html": "Working tips"
  },
  {
   "html": "<ul class=\"do\"><li>Wraps can be built in the morning, wrapped in foil and chilled, then toasted to order.</li><li>The cheese sauce lasts 4–5 days in the fridge or 3 months frozen (whisk it smooth after thawing).</li><li>Cooked wraps freeze well and reheat in the oven.</li></ul>",
   "title_html": "Ahead of time"
  },
  {
   "html": "<ul class=\"do\"><li>Less milk for a thicker sauce, more for a pourable one.</li><li>A pinch of turmeric deepens the colour; jalapeños, chipotle powder or hot sauce bring heat.</li></ul>",
   "title_html": "Cheese sauce"
  },
  {
   "html": "<ul class=\"do\"><li>Breakfast: tofu scramble, vegan sausage, hash browns as the crunch.</li><li>Buffalo cauliflower with ranch.</li><li>BBQ jackfruit with coleslaw and crispy onions.</li></ul>",
   "title_html": "Other fillings"
  },
  {
   "html": "<ul class=\"do\"><li>From Matt’s recipe on <a href=\"https://prdp.net/recipe-folder/vegan-crunch-wrap-supreme\">prdp.net</a> (cheese sauce from his <a href=\"https://prdp.net/techniques/vegan-nacho-cheese\">nacho cheese page</a>), rewritten here.</li><li>Makes 4 big wraps — halve or double as needed.</li></ul>",
   "title_html": "Credit"
  }
 ],
