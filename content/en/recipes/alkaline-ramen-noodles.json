 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Line a tray with foil and spread the baking soda out in a <b>thin, even layer</b>.</li><li>Bake at <b><span class=\"q\" data-k=\"temp\" data-u=\"C\" data-a=\"120\" data-s=\"0\">120 °C</span> (250 °F) for 1 hour</b>. It loses about a third of its weight as it turns into sodium carbonate.</li><li>Let it cool, tip it into a glass jar, close it and <b>label it</b>. It’s a much stronger alkali than baking soda now — handle it with gloves, keep it away from eyes and don’t taste it.</li></ul>",
   "heat": null,
   "id": "step-1",
   "images": {
    "alt": "Bake the baking soda",
    "diagram": null,
    "diagram_title": "Diagram",
    "how": [
     {
      "caption": "Spread the baking soda thinly on a foil-lined tray, then bake 1 hour at 120 °C.",
      "src": "illustrations/alkaline-ramen-noodles/1-how1.webp?v=390e418b38"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/alkaline-ramen-noodles/1.webp?v=f5414453ee",
    "svg_fallback": null
