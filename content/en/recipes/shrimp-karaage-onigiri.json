   "part": "Shrimp karaage",
   "part_id": "part-shrimp-karaage",
   "time": "~12 min",
   "time_html": "<span>~12 min</span>",
   "title": "Peel, devein, curl",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"12\" data-n=\"2\">12</span>",
     "name_html": "Medium shrimp, shell on"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Mix:<ul class=\"ing two-col\"><li>soy sauce <span class=\"amt\"><span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1\">1 tbsp</span></span></li><li>sake <span class=\"amt\"><span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1\">1 tbsp</span></span></li><li>mirin <span class=\"amt\"><span class=\"q\" data-k=\"vol\" data-u=\"tsp\" data-a=\"1\">1 tsp</span></span></li><li>ginger, grated <span class=\"amt\"><span class=\"q\" data-k=\"vol\" data-u=\"tsp\" data-a=\"1\">1 tsp</span></span></li><li>garlic, grated <span class=\"amt\"><span class=\"q\" data-k=\"count\" data-a=\"1\" data-f=\"clove|cloves\" data-n=\"1\">1 small clove</span></span></li></ul></li><li>Toss the shrimp in it and fridge 20–30 minutes.</li></ul>",
   "heat": null,
   "id": "step-3",
