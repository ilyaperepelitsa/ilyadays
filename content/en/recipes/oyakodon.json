   "n": 6,
   "part": null,
   "part_id": null,
   "time": "~5 min",
   "time_html": "<span>~5 min</span>",
   "title": "Let it cool down",
   "uses_rows": []
  },
  {
   "body_html": "<ul class=\"do\"><li>Back on medium.</li><li>Tip in the chicken <b>with all of its marinade</b> (kombu too), spread it in a single layer.</li><li>Bring to a simmer, cover, and simmer, turning once, until cooked through with no pink inside.</li></ul>",
   "heat": {
    "label": "medium",
    "label_html": "<span>medium</span>",
    "off": false
   },
   "id": "step-7",
   "images": {
    "alt": "Chicken in, with all the marinade",
    "how": [
     {
      "caption": "Back on medium: tip in the chicken with all of its marinade, kombu too.",
