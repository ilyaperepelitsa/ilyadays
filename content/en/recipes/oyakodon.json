     "amount_html": "a <span class=\"q\" data-k=\"len\" data-u=\"cm\" data-a=\"2\" data-s=\"0\">2 cm</span> piece (~<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"8\">8 g</span>)",
     "name_html": "Ginger"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"0.5\" data-n=\"1\">½</span> small (~<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"60\">60 g</span>)",
     "name_html": "Onion"
    },
    {
     "amount_html": "a pinch",
     "name_html": "Salt"
    }
   ]
  },
  {
   "body_html": "<p>Take the pan off the heat and let it cool for a few minutes while the chicken finishes marinating.</p>",
   "heat": {
    "label": "heat off",
    "label_html": "heat off",
    "off": true
   },
   "id": "step-6",
   "images": {
    "alt": "Let it cool down",
    "how": [],
    "illustration": "illustrations/oyakodon/6.webp",
