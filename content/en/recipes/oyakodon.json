   },
   "n": 8,
   "part": null,
   "part_id": null,
   "time": "30–60 s",
   "time_html": "<span>30–60 s</span>",
   "title": "Pour ⅔ of the egg",
   "uses_rows": []
  },
  {
   "body_html": "<ul class=\"do\"><li>Pour the remaining egg, cook 10–15 seconds, then <b>turn off the heat</b> and cover for 30 seconds.</li><li>The egg should be glossy and just set.</li><li>Cook a little longer covered if you prefer it firm.</li></ul>",
   "heat": {
    "label": "heat off",
    "label_html": "heat off",
    "off": true
   },
   "id": "step-9",
   "images": {
    "alt": "Pour the rest, heat off",
    "how": [
     {
      "caption": "Pour the last third into the middle, where the egg is thinnest — then heat off, lid on.",
      "src": "illustrations/oyakodon/9-how1.webp"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/oyakodon/9.webp",
    "svg_fallback": null
   },
   "n": 9,
   "part": null,
   "part_id": null,
   "time": "~45 s",
   "time_html": "<span>~45 s</span>",
   "title": "Pour the rest, heat off",
   "uses_rows": []
  },
