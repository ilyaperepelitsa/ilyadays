 "notes": [
  {
   "html": "<ul class=\"do\"><li>Buy tamarind purée/paste rather than a highly concentrated extract: the strength varies, and strong concentrate cannot be substituted spoon for spoon.</li><li>The tamarind supplies the characteristic sourness.</li></ul>",
   "title_html": "Buy tamarind purée/paste, not concentrate"
  },
  {
   "html": "<ul class=\"do\"><li>For a lime-based approximation, start with <b>1 tablespoon lime juice instead</b>, then adjust after cooking.</li><li>It won’t taste identical, but lime is a workable fallback.</li></ul>",
   "title_html": "No tamarind?"
  }
 ],
