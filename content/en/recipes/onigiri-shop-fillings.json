    "svg_fallback": null
   },
   "n": 1,
   "part": null,
   "part_id": null,
   "time": "24 h",
   "time_html": "<span>24 h</span>",
   "title": "Soy-cure the egg yolks",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"4\" data-n=\"1\">4</span>",
     "name_html": "Very fresh egg yolks"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"3\">3 tbsp</span>",
     "name_html": "Soy sauce (yolks)"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1\">1 tbsp</span>",
     "name_html": "Mirin (yolks)"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Put the <b>meat</b>, <b>soy</b>, <b>sugar</b>, <b>sake</b>, <b>mirin</b> and <b>ginger</b> in a cold pan and stir them together before the heat goes on. That keeps the crumbs fine.</li><li>Cook over medium heat, stirring all the time with four chopsticks held together, until the liquid has gone and the meat is fine, glossy and just dry, <b>6–8 minutes</b>.</li><li>Bongo's favourite: a spoon of soboro with one soy-cured yolk on top.</li></ul>",
   "heat": {
    "label": "medium",
    "label_html": "<span>medium</span>",
    "off": false
   },
   "id": "step-2",
   "images": {
