 "notes": [
  {
   "html": "<ul class=\"do\"><li>White cheddar, a browned roux, or thinning the sauce with a lot of milk or pasta water.</li><li>Orange cheddar is the colour; paprika pushes it toward orange without a dark roux.</li></ul>",
   "title_html": "Why it goes pale"
  },
  {
   "html": "<ul class=\"do\"><li>Sweet paprika, stirred in off the heat.</li><li>Smoked paprika is browner and easier to overdo; use it only as a few flecks on top, not in place of the sweet.</li></ul>",
   "title_html": "Paprika"
  },
  {
   "html": "<p>Half a teaspoon in this amount of sauce is for brightness, not a mustard flavour.</p>",
   "title_html": "Dijon"
  },
  {
   "html": "<ul class=\"do\"><li>Cheddar split over a boil goes grainy, and the oil that leaks out looks dull.</li><li>If it seizes, a splash of warm milk off the heat brings it back.</li></ul>",
   "title_html": "Cheese off the heat"
  }
 ],
