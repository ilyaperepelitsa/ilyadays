 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Coarsely grate the orange cheddar.</li><li>Warm the milk in a separate pan or the microwave until it is hot to the touch, not boiling.</li></ul>",
   "heat": null,
   "id": "step-1",
   "images": {
    "alt": "Grate, and warm the milk",
