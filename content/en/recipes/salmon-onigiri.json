 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Wash the rice, soak it 20–30 minutes in the water, then cook it (rice cooker or pot) — the method is on the <a href=\"onigiri.html\">onigiri page</a>.</li><li>Plain rice — no vinegar, no sugar. You need it <b>hot</b> for mixing.</li></ul>",
   "heat": {
    "label": "per your rice cooker",
    "label_html": "<span>per your rice cooker</span>",
    "off": false
   },
   "id": "step-1",
