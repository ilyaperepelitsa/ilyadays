   "uses_rows": []
  },
  {
   "body_html": "<ul class=\"do\"><li>Add the <b>remaining 1 tablespoon oil</b>, the noodles and the sauce.</li><li><b>Spread out, leave briefly to brown</b>, then gently turn.</li><li>Cook for roughly 1–2 minutes.</li></ul>",
   "heat": {
