 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Follow the packet’s <b>stir-fry preparation instructions</b>, stopping while they still have a little firmness.</li><li><b>Drain well and use promptly</b>; they’ll finish cooking in the sauce.</li><li>Avoid fully softening them beforehand or aggressively stirring them in the pan.</li></ul>",
   "heat": null,
   "id": "step-1",
