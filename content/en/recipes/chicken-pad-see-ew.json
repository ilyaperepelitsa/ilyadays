   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Slice the chicken thinly.</li><li>Slice the greens’ <b>stems thinly</b> and keep the leaves separate.</li><li>Chop the garlic and crack the egg into a cup.</li><li>Mix the sauce:<ul class=\"ing two-col\"><li>oyster sauce <span class=\"amt\">1 tbsp</span></li><li>regular soy sauce <span class=\"amt\">1½ tsp</span></li><li>dark soy sauce <span class=\"amt\">1 tsp</span></li><li>rice vinegar <span class=\"amt\">1 tsp</span></li><li>sugar <span class=\"amt\">1 tsp</span></li></ul></li></ul>",
   "heat": null,
   "id": "step-2",
   "images": {
    "alt": "Prep everything",
    "how": [
     {
      "caption": "Slice the stems thinly; keep the leaves separate.",
      "src": "illustrations/chicken-pad-see-ew/2-how1.webp"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/chicken-pad-see-ew/2.webp",
    "svg_fallback": null
   },
   "n": 2,
   "part": null,
   "part_id": null,
   "time": "~8 min",
   "title": "Prep everything",
   "uses_rows": [
    {
     "amount_html": "150 g",
     "name_html": "Chicken"
    },
    {
     "amount_html": "125 g",
     "name_html": "Chinese broccoli or bok choy"
    },
    {
     "amount_html": "2 cloves",
     "name_html": "Garlic"
    },
    {
     "amount_html": "1",
     "name_html": "Egg"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Heat <b>½ tablespoon oil</b> over medium-high heat.</li><li>Cook the chicken until nearly done.</li><li>Add the thinly sliced stems, then garlic and leaves; cook until the chicken is cooked through and greens are tender.</li></ul>",
   "heat": {
    "label": "medium-high",
    "off": false
   },
   "id": "step-3",
   "images": {
    "alt": "Chicken and greens",
    "how": [
