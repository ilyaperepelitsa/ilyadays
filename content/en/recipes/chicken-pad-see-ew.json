   "uses_rows": []
  },
  {
   "body_html": "<p>Push everything aside, scramble the egg in the cleared space, then <b>transfer everything to a plate</b>.</p>",
   "heat": {
    "label": "medium-high",
    "off": false
   },
   "id": "step-4",
