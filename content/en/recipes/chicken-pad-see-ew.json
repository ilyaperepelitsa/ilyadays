   "time": "~8 min",
   "time_html": "<span>~8 min</span>",
   "title": "Prep everything",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"150\">150 g</span>",
     "name_html": "Chicken"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"125\">125 g</span>",
     "name_html": "Chinese broccoli or bok choy"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"2\" data-f=\"clove|cloves\" data-n=\"1\">2 cloves</span>",
     "name_html": "Garlic"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"1\" data-n=\"1\">1</span>",
     "name_html": "Egg"
    }
