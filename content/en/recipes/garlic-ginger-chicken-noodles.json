  {
   "body_html": "<ul class=\"do\"><li>Add bok choy <b>stems</b> for 1–2 minutes, followed by <b>garlic, ginger and spring onion whites</b> for 30 seconds.</li><li>Add the <b>leaves</b> and let them wilt.</li></ul>",
   "heat": {
    "label": "medium-high",
