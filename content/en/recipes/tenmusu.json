   "part": "Shrimp tempura",
   "part_id": "part-shrimp-tempura",
   "time": "~10 min",
   "time_html": "<span>~10 min</span>",
   "title": "Fry",
   "uses_rows": []
  },
  {
   "body_html": "<ul class=\"do\"><li>Pour the mentsuyu into a small bowl.</li><li>Dip <b>both sides</b> of each tempura in it and put it back on the rack.</li></ul>",
   "heat": null,
   "id": "step-7",
   "images": {
    "alt": "Dip in mentsuyu",
    "diagram": null,
    "how": [
     {
      "caption": "Dip both sides in the mentsuyu.",
