   },
   "n": 7,
   "part": "Sweet-soy baby octopus",
   "part_id": "part-sweet-soy-baby-octopus",
   "time": "20 min",
   "time_html": "<span>20 min</span>",
   "title": "Simmer in sweet soy",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1.5\">1½ tbsp</span>",
     "name_html": "Soy sauce"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1.5\">1½ tbsp</span>",
     "name_html": "Mirin (for the simmer)"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1\">1 tbsp</span>",
