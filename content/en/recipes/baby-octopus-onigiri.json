    "zoomable": true
   },
   "n": 4,
   "part": "Plain rice",
   "part_id": "part-plain-rice",
   "time": "~25 min including soaking",
   "time_html": "<span>~25 min including soaking</span>",
   "title": "Wash rice; finely chop ginger",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"225\">225 g</span>",
     "name_html": "Short-grain rice"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"ml\" data-a=\"300\">300 ml</span>",
     "name_html": "Water for rice"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"14\">14 g</span>",
     "name_html": "Ginger"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Rice cooker: cook the soaked rice in its measured fresh water on the normal short-grain setting. Do not add octopus, octopus liquor, soy, dashi or glaze.</li><li>Pot: bring to a boil, cover tightly, cook on the lowest heat for 12–13 minutes until absorbed, then rest off heat covered for 10 minutes. Follow your rice packet if its water ratio differs.</li><li>Fluff gently and keep covered until the octopus is ready.</li></ul>",
   "heat": null,
   "id": "step-5",
