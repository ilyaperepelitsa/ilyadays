 "notes": [
  {
   "html": "<ul class=\"do\"><li>Use 4–5 different vegetables with different colours.</li><li>Cucumber in thin slices (salted and squeezed), radish or kimchi all work, as do fernbrake (gosari) or bellflower root (doraji) if you find them in an Asian shop.</li></ul>",
   "title_html": "Vegetables are flexible"
  },
  {
   "html": "<p>Use <span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"150\" data-s=\"0\">150 g</span> minced beef fried with <span class=\"q\" data-k=\"vol\" data-u=\"tbsp\" data-a=\"1\" data-s=\"0\">1 tbsp</span> soy sauce, <span class=\"q\" data-k=\"vol\" data-u=\"tsp\" data-a=\"1\" data-s=\"0\">1 tsp</span> sugar and garlic, or sliced <a href=\"dak-bulgogi.html\">dak bulgogi</a>, or leave it vegetarian with an extra egg.</p>",
   "title_html": "Without bulgogi"
  }
 ],
