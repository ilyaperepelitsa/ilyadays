 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Slice the whites and light-green parts <b>thinly</b> (a little of the dark green is fine) — about <span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"3\" data-s=\"0\">3 cups</span>.</li><li>Put them in the heatproof bowl.</li></ul>",
   "heat": null,
   "id": "step-1",
   "images": {
    "alt": "Slice the scallions",
    "diagram": null,
    "diagram_title": "Diagram",
    "how": [
