  },
  {
   "body_html": "<p>Soak the cashews for the gravy in <span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"0.5\" data-s=\"0\">½ cup</span> hot water until you grind them.</p>",
   "heat": null,
   "id": "step-8",
   "images": {
    "alt": "Soak the cashews",
    "diagram": null,
    "how": [],
    "illustration": "illustrations/chicken-malai-tikka/8.webp?v=6e87c340e4",
