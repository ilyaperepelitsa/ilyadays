    "svg_fallback": null
   },
   "n": 7,
   "part": null,
   "part_id": null,
   "time": "~2–3 min",
   "title": "First fry — pale",
   "uses_rows": []
  },
  {
   "body_html": "<ul class=\"do\"><li>Lift onto a rack for a few minutes.</li><li>The heat inside keeps cooking the chicken while the oil comes back up to temperature.</li></ul>",
   "heat": null,
   "id": "step-8",
   "images": {
    "alt": "Rest",
    "how": [
     {
      "caption": "Lift them onto the rack with a spider and let them rest.",
