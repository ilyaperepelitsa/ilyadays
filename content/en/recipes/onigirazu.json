   "n": 6,
   "part": "Build (one onigirazu)",
   "part_id": "part-build-one-onigirazu",
   "time": "1 min",
   "time_html": "<span>1 min</span>",
   "title": "First rice layer",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"4\">4 cups</span><span class=\"qalt\"> (~<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"600\" data-alt=\"1\">600 g</span>)</span>",
     "name_html": "Cooked Japanese short-grain rice, warm"
    },
    {
     "amount_html": "a pinch per layer",
     "name_html": "Kosher salt"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>A lettuce leaf on the rice, folded to fit the square.</li><li>A drizzle of Kewpie over the lettuce.</li><li>A quarter of the ginger pork and its onion on top, folded and <b>piled high in the middle</b> — think about where you’ll cut, so the filling shows.</li></ul>",
   "heat": null,
