    "svg_fallback": null
   },
   "n": 1,
   "part": "Ginger pork",
   "part_id": "part-ginger-pork",
   "time": "~6 min",
   "time_html": "<span>~6 min</span>",
   "title": "Ginger sauce",
   "uses_rows": [
    {
     "amount_html": "<span class=\"q\" data-k=\"len\" data-u=\"cm\" data-a=\"5\" data-s=\"0\">5 cm</span> piece",
     "name_html": "Fresh ginger"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"0.5\" data-n=\"1\">½</span>",
     "name_html": "Onion"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Slice the rest of the onion thinly.</li><li>If the pork slices are thicker than <span class=\"q\" data-k=\"len\" data-u=\"mm\" data-a=\"3\" data-s=\"0\">3 mm</span>, make a few small cuts through the white strip between meat and fat, so they stay flat.</li><li>Sprinkle the pork with the other half of the ginger juice and the sake. Leave 5 minutes.</li><li>Just before cooking, dust the slices lightly with the flour (skip it for paper-thin slices).</li></ul>",
   "heat": null,
   "id": "step-2",
   "images": {
    "alt": "Pork and onion",
    "diagram": null,
    "diagram_title": "Diagram",
    "how": [
