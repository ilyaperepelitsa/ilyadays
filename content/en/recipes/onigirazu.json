    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"4\" data-f=\"sheet|sheets\" data-n=\"1\">4 sheets</span>",
     "name_html": "Nori"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Spread <b><span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"0.5\" data-s=\"0\">½ cup</span><span class=\"qalt\"> (~<span class=\"q\" data-k=\"mass\" data-u=\"g\" data-a=\"75\" data-s=\"0\" data-alt=\"1\">75 g</span>)</span></b> warm rice in a thin, even <b>square</b> in the middle of the nori, about <span class=\"q\" data-k=\"len\" data-u=\"cm\" data-a=\"9\" data-s=\"0\">9 cm</span> a side. Leave the four corners of nori bare.</li><li>Sprinkle with a pinch of salt.</li></ul>",
   "heat": null,
