     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"ml\" data-a=\"60\">60 ml</span><span class=\"qalt\"> (<span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"0.25\" data-alt=\"1\">¼ cup</span>)</span>",
     "name_html": "Sake"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"ml\" data-a=\"120\">120 ml</span><span class=\"qalt\"> (<span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"0.5\" data-alt=\"1\">½ cup</span>)</span>",
     "name_html": "Mirin"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"vol\" data-u=\"ml\" data-a=\"120\">120 ml</span><span class=\"qalt\"> (<span class=\"q\" data-k=\"vol\" data-u=\"cup\" data-a=\"0.5\" data-alt=\"1\">½ cup</span>)</span>",
     "name_html": "Soy sauce"
    }
   ]
  },
  {
