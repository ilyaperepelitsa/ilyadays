 "steps": [
  {
   "body_html": "<ul class=\"do\"><li>Slice onion into <span class=\"q\" data-k=\"len\" data-u=\"mm\" data-a=\"1\" data-b=\"2\" data-s=\"0\">1–2 mm</span> half-moons.</li><li>Massage with half the salt for 30 seconds, then mix with lemon and optional sumac.</li><li>Leave for 10 minutes while cooking; add optional parsley at the end.</li></ul>",
