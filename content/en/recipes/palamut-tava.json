 "notes": [
  {
   "html": "<ul class=\"do\"><li>Palamut means bonito.</li><li>Ask for today’s properly iced fish and have it cleaned ashore; do not buy fish that has been standing warm.</li></ul>",
   "title_html": "Buying"
