    "svg_fallback": null
   },
   "n": 6,
   "part": null,
   "part_id": null,
   "time": "~1 min each",
   "time_html": "<span>~1 min each</span>",
   "title": "Rice into the mold",
   "uses_rows": [
    {
     "amount_html": "~<span class=\"q\" data-k=\"mass\" data-u=\"kg\" data-a=\"1.3\">1.3 kg</span>",
     "name_html": "Cooked short-grain rice, warm"
    },
    {
     "amount_html": "<span class=\"q\" data-k=\"count\" data-a=\"2\" data-f=\"sheet|sheets\" data-n=\"1\">2 sheets</span>",
     "name_html": "Nori"
    }
   ]
  },
  {
   "body_html": "<ul class=\"do\"><li>Sprinkle furikake over the rice; add a piece of egg if you made it; top with a glazed Spam slice, carrying a little glaze.</li><li>Press down firmly with the mold's lid to pack the rice into a block.</li><li>Keep pressing the lid down with one hand and lift the mold's frame off with the other.</li></ul>",
   "heat": null,
   "id": "step-7",
