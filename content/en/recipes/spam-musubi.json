    "diagram": null,
    "how": [
     {
      "caption": "Cook the beaten egg as one thin omelette, without browning; flip once.",
      "src": "illustrations/spam-musubi/3-how1.webp?v=598c2a6a02"
     },
     {
      "caption": "Cut it into 8 pieces the size of a slice.",
      "src": "illustrations/spam-musubi/3-how2.webp?v=938eec22c1"
