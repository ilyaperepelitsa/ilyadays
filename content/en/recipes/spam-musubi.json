    "diagram": null,
    "how": [
     {
      "caption": "Pour in the sauce; cook 1–2 minutes, flipping once, until it's a thick shiny glaze.",
      "src": "illustrations/spam-musubi/5-how1.webp?v=519962f1ab"
     }
    ],
    "illustration": null,
    "photo": null,
    "result": "illustrations/spam-musubi/5.webp?v=673c6f019f",
