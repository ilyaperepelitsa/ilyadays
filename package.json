{
  "name": "ilyadays",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fitness-image-index.mjs && node scripts/write-offline-catalog.mjs && node scripts/aurelius-analysis-check.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/trips/*.test.mjs tests/offline/*.test.mjs tests/food/*.test.mjs tests/site/*.test.mjs tests/fitness/*.test.mjs tests/aurelius/*.test.mjs",
    "sync": "bash scripts/sync-content.sh",
    "check:cookies": "node scripts/check-no-cookies.mjs",
    "test:fitness:sql": "bash scripts/fitness-sql-check.sh",
    "test:fitness:e2e": "bash scripts/fitness-e2e.sh",
    "check:fitness:catalog": "node scripts/fitness-machine-specs.mjs check && node scripts/fitness-catalog-seed.mjs --check",
    "aurelius:dev": "node scripts/aurelius-dev.mjs",
    "test:aurelius": "node scripts/aurelius-test.mjs",
    "aurelius:analysis": "apps/aurelius/.venv/bin/python scripts/aurelius-analysis.py",
    "aurelius:corpus": "apps/aurelius/.venv/bin/python scripts/aurelius-corpus.py"
  },
  "dependencies": {
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@supabase/supabase-js": "^2.89.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-unique-id": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/oidc": "4.0.8",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
